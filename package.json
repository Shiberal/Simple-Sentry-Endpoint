{
  "name": "edt",
  "version": "0.1.0",
  "private": true,
  "description": "EDT — a toolbox of deployable tools. Each tool lives under tools/ and can be built, run, and shipped on its own.",
  "workspaces": [
    "tools/*"
  ],
  "scripts": {
    "dev:simple-sentry": "npm run dev -w @edt/simple-sentry-endpoint",
    "build:simple-sentry": "npm run build -w @edt/simple-sentry-endpoint",
    "start:simple-sentry": "npm run start -w @edt/simple-sentry-endpoint",
    "lint:simple-sentry": "npm run lint -w @edt/simple-sentry-endpoint",
    "test:simple-sentry": "npm run test -w @edt/simple-sentry-endpoint"
  },
  "engines": {
    "node": ">=20"
  }
}
