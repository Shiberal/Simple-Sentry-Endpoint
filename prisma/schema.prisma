// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum IssueStatus {
  UNRESOLVED
  RESOLVED
  IGNORED
  IN_PROGRESS
}

enum EventType {
  ERROR
  CSP
  MINIDUMP
  TRANSACTION
  MESSAGE
  CHECK_IN
}

model User {
  id             Int       @id @default(autoincrement())
  email          String    @unique
  username       String?   @unique @default(uuid())
  name           String?
  password       String
  isAdmin        Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  projects       Project[] @relation("ProjectUsers")
  assignedIssues Issue[]   @relation("AssignedIssues")
  ownedProjects  Project[] @relation("ProjectOwners")
  comments       Comment[]
}

model Project {
  id                       Int               @id @default(autoincrement())
  name                     String
  key                      String            @unique
  githubRepo               String?
  githubToken              String?
  autoGithubReport         Boolean           @default(false)
  autoGithubReportFilters  Json?
  telegramChatId           String?
  fingerprintByPageUrl     Boolean           @default(false)
  ingestFilters            Json?
  scrubRules               Json?
  sampleRate               Float?
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
  events                   Event[]
  users                    User[]            @relation("ProjectUsers")
  projectOwners            User[]            @relation("ProjectOwners")
  issues                   Issue[]
  alertRules               AlertRule[]
  releases                 Release[]
  debugFiles               DebugFile[]
  cronMonitors             CronMonitor[]
}

model Issue {
  id                 Int           @id @default(autoincrement())
  projectId          Int
  project            Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fingerprint        String
  title              String
  culprit            String?
  level              String        @default("error")
  status             IssueStatus   @default(UNRESOLVED)
  count              Int           @default(1)
  firstSeen          DateTime      @default(now())
  lastSeen           DateTime      @default(now())
  assignedToId       Int?
  assignedTo         User?         @relation("AssignedIssues", fields: [assignedToId], references: [id], onDelete: SetNull)
  githubIssueUrl     String?
  githubIssueNumber  Int?
  violatedDirective  String?
  blockedUri         String?
  sourceFile         String?
  mergedIntoId       Int?
  mergedInto         Issue?        @relation("IssueMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFromIssues   Issue[]       @relation("IssueMerge")
  events             Event[]
  comments           Comment[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@unique([projectId, fingerprint])
  @@index([projectId, status])
  @@index([projectId, lastSeen])
  @@index([projectId, githubIssueNumber])
  @@index([mergedIntoId])
}

model Event {
  id               Int           @id @default(autoincrement())
  projectId        Int
  project          Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issueId          Int?
  issue            Issue?        @relation(fields: [issueId], references: [id], onDelete: SetNull)
  eventType        EventType     @default(ERROR)
  promotedPageUrl  String?
  promotedRelease  String?
  promotedEnv      String?
  data             Json
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([issueId])
  @@index([projectId, createdAt])
  @@index([projectId, eventType])
  @@index([projectId, promotedPageUrl])
  @@index([projectId, promotedRelease])
}

model Comment {
  id        Int      @id @default(autoincrement())
  issueId   Int
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime @default(now())

  @@index([issueId])
}

model AlertRule {
  id                 Int       @id @default(autoincrement())
  projectId          Int
  project            Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name               String
  enabled            Boolean   @default(true)
  condition          Json
  emailRecipients    String    @default("")
  slackWebhookUrl    String?
  genericWebhookUrl  String?
  lastTriggered      DateTime?
  spikeBaselineCount Int?
  spikeBaselineAt    DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([projectId, enabled])
}

model Release {
  id         Int      @id @default(autoincrement())
  projectId  Int
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version    String
  firstSeen  DateTime @default(now())
  lastSeen   DateTime @default(now())
  eventCount Int      @default(0)

  @@unique([projectId, version])
  @@index([projectId, lastSeen])
}

model DebugFile {
  id          Int      @id @default(autoincrement())
  projectId   Int
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  release     String
  dist        String?
  headerName  String
  checksum    String?
  storagePath String
  createdAt   DateTime @default(now())

  @@index([projectId, release])
}

model CronMonitor {
  id            Int               @id @default(autoincrement())
  projectId     Int
  project       Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  slug          String
  name          String?
  status        String            @default("active")
  schedule      String?
  environment   String?
  lastCheckInAt DateTime?
  checkIns      MonitorCheckIn[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([projectId, slug])
  @@index([projectId, status])
}

model MonitorCheckIn {
  id          Int          @id @default(autoincrement())
  monitorId   Int
  monitor     CronMonitor  @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  status      String
  environment String?
  durationMs  Float?
  data        Json?
  createdAt   DateTime     @default(now())

  @@index([monitorId, createdAt])
}

model SystemSettings {
  id                    Int       @id @default(0)
  allowSelfRegistration Boolean   @default(true)
  allowProjectCreation  Boolean   @default(false)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}
